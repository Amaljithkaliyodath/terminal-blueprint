
{
  "name": "terminal-blueprint",
  "displayName": "Terminal Blueprint",
  "description": "Scan projects, review verified terminal suggestions, and manage reusable terminal blueprints",
  "version": "0.0.1",
  "publisher": "amalkali",
  "license": "MIT",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "terminal",
    "project scanner",
    "command suggestions",
    "blueprints",
    "developer tools"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/Amaljithkaliyodath/terminal-blueprint.git"
  },
  "homepage": "https://github.com/Amaljithkaliyodath/terminal-blueprint#readme",
  "bugs": {
    "url": "https://github.com/Amaljithkaliyodath/terminal-blueprint/issues"
  },
  "sponsor": {
    "url": "https://buymeacoffee.com/amaljithkab"
  },
  "activationEvents": [],
  "main": "./out/extension.js",
  "icon": "resources/terminal-blueprint.png",
  "contributes": {
    "configuration": {
      "title": "Terminal Blueprint",
      "properties": {
        "terminalBlueprint.autoScan": {
          "type": "boolean",
          "default": false,
          "description": "Automatically perform a read-only project scan when a trusted workspace opens."
        },
        "terminalBlueprint.showNotifications": {
          "type": "boolean",
          "default": true,
          "description": "Show informational notifications from Terminal Blueprint."
        },
        "terminalBlueprint.scanMaxDepth": {
          "type": "integer",
          "default": 4,
          "minimum": 0,
          "maximum": 4,
          "description": "Maximum nested directory depth for project scanning (0 to 4)."
        },
        "terminalBlueprint.excludedDirectories": {
          "type": "array",
          "default": ["$RECYCLE.BIN", ".git", ".next", ".venv", "__pycache__", "build", "coverage", "dist", "env", "node_modules", "out", "System Volume Information", "target", "venv"],
          "items": { "type": "string" },
          "description": "Directory names to exclude from project scans. Built-in protected exclusions always remain active."
        }
      }
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "terminal-blueprint",
          "title": "Terminal Blueprint",
          "icon": "resources/terminal-blueprint.svg"
        }
      ]
    },
    "views": {
      "terminal-blueprint": [
        {
          "id": "terminalBlueprint.sidebar",
          "name": "Terminal Blueprint"
        }
      ]
    },
    "commands": [
      {
        "command": "terminal-blueprint.scanProject",
        "title": "Terminal Blueprint: Scan Project",
        "icon": "$(search)"
      },
      {
        "command": "terminal-blueprint.runSuggestedCommand",
        "title": "Terminal Blueprint: Run Suggested Command"
      },
      {
        "command": "terminal-blueprint.createBlueprint",
        "title": "Terminal Blueprint: Create Blueprint",
        "icon": "$(add)"
      },
      {
        "command": "terminal-blueprint.manageBlueprints",
        "title": "Terminal Blueprint: Manage Blueprints",
        "icon": "$(gear)"
      },
      {
        "command": "terminal-blueprint.importBlueprints",
        "title": "Terminal Blueprint: Import Blueprints"
      },
      {
        "command": "terminal-blueprint.exportBlueprints",
        "title": "Terminal Blueprint: Export Blueprints"
      },
      {
        "command": "terminal-blueprint.checkBlueprintCompatibility",
        "title": "Terminal Blueprint: Check Blueprint Compatibility"
      },
      {
        "command": "terminal-blueprint.runBlueprint",
        "title": "Terminal Blueprint: Run Blueprint"
      },
      {
        "command": "terminal-blueprint.refreshSidebar",
        "title": "Terminal Blueprint: Refresh Sidebar",
        "icon": "$(refresh)"
      },
      {
        "command": "terminal-blueprint.supportDevelopment",
        "title": "Terminal Blueprint: Support Development"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "terminal-blueprint.scanProject",
          "when": "view == terminalBlueprint.sidebar",
          "group": "navigation@1"
        },
        {
          "command": "terminal-blueprint.refreshSidebar",
          "when": "view == terminalBlueprint.sidebar",
          "group": "navigation@2"
        },
        {
          "command": "terminal-blueprint.createBlueprint",
          "when": "view == terminalBlueprint.sidebar",
          "group": "navigation@3"
        },
        {
          "command": "terminal-blueprint.manageBlueprints",
          "when": "view == terminalBlueprint.sidebar",
          "group": "navigation@4"
        }
      ],
      "view/item/context": [
        {
          "command": "terminal-blueprint.scanProject",
          "when": "view == terminalBlueprint.sidebar && viewItem == terminal-blueprint.category.projects",
          "group": "navigation@1"
        },
        {
          "command": "terminal-blueprint.runSuggestedCommand",
          "when": "view == terminalBlueprint.sidebar && viewItem == terminal-blueprint.suggestion",
          "group": "navigation@1"
        },
        {
          "command": "terminal-blueprint.createBlueprint",
          "when": "view == terminalBlueprint.sidebar && viewItem == terminal-blueprint.category.blueprints",
          "group": "navigation@1"
        },
        {
          "command": "terminal-blueprint.manageBlueprints",
          "when": "view == terminalBlueprint.sidebar && viewItem == terminal-blueprint.category.blueprints",
          "group": "navigation@2"
        },
        {
          "command": "terminal-blueprint.manageBlueprints",
          "when": "view == terminalBlueprint.sidebar && viewItem == terminal-blueprint.blueprint",
          "group": "navigation@1"
        },
        {
          "command": "terminal-blueprint.checkBlueprintCompatibility",
          "when": "view == terminalBlueprint.sidebar && viewItem == terminal-blueprint.blueprint",
          "group": "navigation@2"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/vscode": "1.85.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "24.x",
    "typescript-eslint": "^8.61.1",
    "eslint": "^10.5.0",
    "typescript": "^6.0.3",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.0.0"
  },
  "overrides": {
    "diff": "^8.0.4",
    "serialize-javascript": "^7.0.6"
  }
}
